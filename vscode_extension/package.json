{
	"name": "liana",
	"displayName": "Liana",
	"version": "0.1.85",
	"publisher": "corno",
	"description": "Language support for Liana, whose documents are written in ASTN syntax: syntax highlighting, intelligent code completion, schema-based validation, formatting, and JSON conversion.",
	"author": "Corno",
	"license": "Apache-2.0",
	"icon": "images/liana.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/corno/liana-vscode"
	},
	"bugs": {
		"url": "https://github.com/corno/liana-vscode/issues"
	},
	"homepage": "https://github.com/corno/liana-vscode#readme",
	"files": [
		"client/out/extension.js",
		"server/out/server.js",
		"syntaxes/astn.tmLanguage.json",
		"images/liana.png",
		"language-configuration.json",
		"liana_authoring_environment_template/**",
		"README.md",
		"CHANGELOG.md",
		"LICENSE.md"
	],
	"categories": [
		"Programming Languages",
		"Formatters",
		"Linters",
		"Snippets"
	],
	"keywords": [
		"liana",
		"astn",
		"syntax highlighting",
		"code completion",
		"intellisense",
		"formatting",
		"validation",
		"schema",
		"json",
		"type checking",
		"data format",
		"structured data"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [
			{
				"id": "liana",
				"aliases": [
					"liana"
				],
				"extensions": [
					".liana",
					".lna"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "liana",
				"scopeName": "source.liana",
				"path": "./syntaxes/astn.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": "support.type.singular_structural_token.astn",
						"settings": {
							"foreground": "#fd3c7c"
						}
					},
					{
						"scope": "support.type.apostrophed_string.astn",
						"settings": {
							"foreground": "#9CDCFE"
						}
					},
					{
						"scope": "support.type.undelimited_string.astn",
						"settings": {
							"foreground": "#9c8a21"
						}
					},
					{
						"scope": "support.type.backticked_string.astn",
						"settings": {
							"foreground": "#569CD6"
						}
					},
					{
						"scope": "string.quoted.double.astn",
						"settings": {
							"foreground": "#CE9178"
						}
					}
				]
			}
		},
		"configuration": {
			"type": "object",
			"title": "Liana configuration",
			"properties": {}
		},
		"commands": [
			{
				"command": "liana.initialize_liana_schema_authoring_environment",
				"category": "Liana",
				"title": "initialize Liana schema authoring environment"
			},
			{
				"command": "liana.sort_dictionary",
				"category": "Liana",
				"title": "sort dictionary"
			},
			{
				"command": "liana.jump_to_next_missing_data",
				"category": "Liana",
				"title": "jump to next missing_data (#)"
			},
			{
				"command": "liana.jump_to_next_missing_data_opposite_style",
				"category": "Liana",
				"title": "jump to next missing_data (#) in opposite notation style"
			},
			{
				"command": "liana.collapse_all_entries",
				"category": "Liana",
				"title": "collapse all entries"
			},
			{
				"command": "liana.convert_to_json",
				"category": "Liana",
				"title": "Convert document to JSON notation"
			},
			{
				"command": "liana.save_as_json",
				"category": "Liana",
				"title": "save as JSON file"
			},
			{
				"command": "liana.save_as_json_disabled",
				"category": "Liana",
				"title": "save as JSON file (n/a due to errors)"
			},
			{
				"command": "liana.seal",
				"category": "Liana",
				"title": "seal document"
			},
			{
				"command": "liana.seal_disabled",
				"category": "Liana",
				"title": "seal document (n/a due to errors)"
			},
			{
				"command": "liana.publish_schema_to_authoring_environment",
				"category": "Liana",
				"title": "Publish this Liana schema to an authoring environment..."
			},
			{
				"command": "liana.create_liana_file",
				"category": "Liana",
				"title": "New Liana File..."
			},
			{
				"command": "liana.toggle_notation_style",
				"category": "Liana",
				"title": "Toggle notation style (Verbose/Concise)"
			}
		],
		"keybindings": [
			{
				"command": "liana.jump_to_next_missing_data",
				"key": "ctrl+3",
				"when": "editorTextFocus && editorLangId == liana"
			},
			{
				"command": "liana.jump_to_next_missing_data",
				"key": "ctrl+d",
				"when": "editorTextFocus && editorLangId == liana"
			},
			{
				"command": "liana.jump_to_next_missing_data_opposite_style",
				"key": "ctrl+shift+d",
				"when": "editorTextFocus && editorLangId == liana"
			},
			{
				"command": "liana.toggle_notation_style",
				"key": "ctrl+alt+n",
				"when": "editorTextFocus && editorLangId == liana"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "liana.sort_dictionary",
					"when": "false"
				},
				{
					"command": "liana.convert_to_json",
					"when": "false"
				}
			],
			"editor/context": [
				{
					"command": "liana.save_as_json",
					"when": "editorLangId == liana && !liana.has_parse_errors",
					"group": "1_liana"
				},
				{
					"command": "liana.save_as_json_disabled",
					"when": "editorLangId == liana && liana.has_parse_errors",
					"group": "1_liana"
				},
				{
					"command": "liana.collapse_all_entries",
					"when": "editorLangId == liana",
					"group": "1_liana"
				},
				{
					"command": "liana.seal",
					"when": "editorLangId == liana && !liana.has_errors",
					"group": "1_liana"
				},
				{
					"command": "liana.seal_disabled",
					"when": "editorLangId == liana && liana.has_errors",
					"group": "1_liana"
				},
				{
					"command": "liana.publish_schema_to_authoring_environment",
					"when": "editorLangId == liana && !liana.has_errors && resourceFilename =~ /\\.liana\\.lna$/",
					"group": "1_liana"
				}
			],
			"explorer/context": [
				{
					"command": "liana.create_liana_file",
					"when": "explorerResourceIsFolder && liana.workspaceHasSchema",
					"group": "navigation@1"
				},
				{
					"command": "liana.publish_schema_to_authoring_environment",
					"when": "resourceExtname == .lna && resourceFilename =~ /\\.liana\\.lna$/",
					"group": "liana@1"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run bundle",
		"bundle": "node ./esbuild.js --production",
		"bundle:watch": "node ./esbuild.js --watch",
		"compile:backend": "tsc --project ../pareto_liana/tsconfig.json && tsc --project ../liana_authoring/tsconfig.json",
		"compile": "npm run compile:backend && tsc --project client/tsconfig.json && tsc --project server/tsconfig.json",
		"watch": "tsc --project client/tsconfig.json -w & tsc --project server/tsconfig.json -w",
		"lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd .."
	},
	"devDependencies": {
		"esbuild": "^0.28.1"
	},
	"dependencies": {
		"astn": "^0.113.0",
		"astn-runtime": "^0.1.5",
		"liana-authoring": "file:../liana_authoring",
		"pareto-filesystem-unrestricted-api": "^0.1.39",
		"pareto-json": "^0.3.0",
		"pareto-liana": "file:../pareto_liana",
		"pareto-resource-filesystem-unrestricted": "^0.1.4",
		"typescript": "^6.0.3"
	}
}
