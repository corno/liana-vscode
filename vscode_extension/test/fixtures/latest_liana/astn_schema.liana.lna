                    'root': < * "The document root type, selected from the root schema" | `reference` < < < | `local` 'Schema' > < [
                        | `group` 'types'
                    ] > > < | `acyclic` ~ _ > > >
                } >
                'Schema': < | `public` ~ | `group` {
