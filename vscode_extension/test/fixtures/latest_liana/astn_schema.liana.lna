                                | `group` 'types'
                                | `dictionary` ~
                            ] > > > >
                        } _ > >
                    } >
                    'dictionary': < * "Indexed collection of named values (like a map or hash table)" _ | `component` < | `cyclic` 'Value' _ > >
                    'group': < * "Collection of properties, each with a specific name and type" _ | `group` {
                        'properties': < _ | `dictionary` < _ | `group` {
                            'description': < * "Documentation shown in IDE for this property" | `optional` < _ | `simple` 'multi line text' _ > >
                            'value': < * "The type of this property" | `component` < | `cyclic` 'Value' _ > >
                        } > >
                    } >
                    'identifier': < * "A value that uniquely identifies an entity (denoted with single quotes)" _ | `reference` < < < | `local` 'Text Types' > < [] > > < | `acyclic` ~ _ > > >
                    'list': < * "Ordered sequence of values of the same type" _ | `component` < | `cyclic` 'Value' _ > >
                    'nothing': < * "Empty value (unit type, no data)" _ | `nothing` ~ >
                    'optional': < * "Value that may or may not be present" _ | `component` < | `cyclic` 'Value' _ > >
                    'state': < * "Tagged union: value is one of several named options (like a sum type or enum)" _ | `group` {
                        'options': < * "The possible variants, each with its own name and associated data" | `dictionary` < _ | `group` {
                            'description': < * "Documentation shown in IDE for this option" | `optional` < _ | `simple` 'multi line text' _ > >
                            'value': < _ | `component` < | `cyclic` 'Value' _ > >
                        } > >
                    } >
                    'text': < * "A text value (denoted with double quotes or no delimiter)" _ | `reference` < < < | `local` 'Text Types' > < [] > > < | `acyclic` ~ _ > > >
