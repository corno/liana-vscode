                                | `group` 'types'
                            ] > > < | `cyclic` ~ _ > > >
                            'simple': < * "Reference an acyclic local, child schema, or sibling schema type" _ | `state` < {
                                'local': < * "Type in the current schema" _ | `reference` < < < | `local` 'Schema' > < [
                                    | `group` 'types'
                                ] > > < | `acyclic` ~ _ > > >
                                'child schema': < _ _ | `group` {
                                    'schema': < _ | `reference` < < < | `local` 'Schemas' > < [] > > < | `acyclic` ~ _ > > >
                                    'type': < _ | `reference` < < < | `local` 'Schema' > < [
                                        | `group` 'types'
                                    ] > > < | `acyclic` ~ _ > > >
                                } >
