/*
TODO:
- 'Type Specification' should be able to describe a file tree, making it possible to define hierarchical structures of files and directories, conforming to different schema types
- constraints that don't provide access to a value (but are needed for semantic correctness);
-- optional values should be able to have a constraint on 'not set' requiring that another value is also 'not set'
-- Identity constraints. It should be possible to have 2 paths that must point to the same value.
*/
(
    `schema`: (
        `structure`: (
            `namespaces`: {
                'structure': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Basic Type': < | `group` {
                            'type': < * "How the value is delimited in a document" | `state` < {
                                'double quoted': < _ _ | `nothing` ~ >
                                'undelimited': < _ _ | `nothing` ~ >
                            } _ > >
                            'regular expression': < * "Optional regular expression matched against the entire value" | `optional` < _ | `component` < | `internal` 'Regular Expression' _ > _ > >
                            'hyperlink': < * "Optional hyperlink metadata; the target is prefix + authored value + suffix, without changing the authored value" | `optional` < _ | `group` {
                                'prefix': < _ | `simple` 'text' >
                                'suffix': < _ | `simple` 'text' >
                            } _ > >
                        } >
                        'Basic Types': < | `dictionary` < | `component` < | `internal` 'Basic Type' _ > > >
                        'Dictionary': < | `group` {
                            'value': < * "The type of each entry in this dictionary" | `component` < | `internal cyclic` 'Value' _ > >
                        } >
                        'Group': < | `dictionary` < | `group` {
                            'description': < * "Documentation shown in IDE for this property" | `optional` < _ | `simple` 'multi line text' _ > >
                            'value': < * "The type of this property" | `component` < | `internal cyclic` 'Value' _ > >
                        } > >
                        'Namespaces': < | `dictionary` < | `component` < | `internal cyclic` 'Structure' _ > > >
                        'Option Constraints': < | `optional` < _ | `dictionary` < | `component` < | `internal` 'Value Reference' _ > > _ > >
                        'Reference': < | `group` {
                            'referent': < * "What this reference points to" | `component` < | `internal cyclic` 'Value Reference' * {
                                'dictionary': (
                                    `type`: (
                                        `location`: | `internal` 'Value'
                                    )
                                    `path`: (
                                        `tail`: [
                                            | `state` 'dictionary'
                                        ]
                                    )
                                )
                            } > >
                            'type': < _ | `group` {
                                'dependency': < * "How this reference affects dependency order" | `state` < {
                                    'acyclic': < * "No circular dependencies (default for cross-type references)" _ | `nothing` ~ >
                                    'cyclic': < * "Allows circular instance references (only within same dictionary)" _ | `nothing` ~ >
                                } _ > >
                                'constraints': < _ | `component` < | `internal cyclic` 'Reference Constraints' _ > >
                            } >
                        } >
                        'Reference Constraints': < | `optional` < _ | `dictionary` < | `component` < | `internal` 'Value Reference' _ > > _ > >
                        'Regular Expression': < | `state` < {
                            'any character': < * "Match exactly one character, including line breaks" _ | `nothing` ~ >
                            'literal': < * "Match this exact text; an empty literal matches no characters" _ | `simple` 'text' >
                            'character set': < * "Match exactly one character from this text; an empty set never matches. Use 0123456789 for JSON digits" _ | `simple` 'text' >
                            'sequence': < * "Match every expression in order; an empty sequence matches no characters" _ | `list` < | `component` < | `internal cyclic` 'Regular Expression' _ > _ > >
                            'choice': < * "Match any one expression; an empty choice never matches" _ | `list` < | `component` < | `internal cyclic` 'Regular Expression' _ > _ > >
                            'repetition': < * "Repeat an expression using one of the three basic quantifiers" _ | `group` {
                                'expression': < _ | `component` < | `internal cyclic` 'Regular Expression' _ > >
                                'quantity': < _ | `state` < {
                                    'optional': < * "Zero or one occurrence" _ | `nothing` ~ >
                                    'zero or more': < _ _ | `nothing` ~ >
                                    'one or more': < _ _ | `nothing` ~ >
                                } _ > >
                            } >
                        } _ > >
                        'Structure': < | `group` {
                            'namespaces': < _ | `component` < | `internal` 'Namespaces' _ > >
                            'basic types': < _ | `component` < | `internal` 'Basic Types' _ > >
                            'types': < _ | `component` < | `internal cyclic` 'Types' _ > >
                        } >
                        'Type': < | `group` {
                            'root value': < _ | `component` < | `internal cyclic` 'Value' _ > >
                        } >
                        'Type Reference': < | `group` {
                            'location': < * "Where the referenced type is defined" | `state` < {
                                'internal': < * "Type is in the same schema" _ | `reference` < < < | `internal` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                'child': < _ _ | `group` {
                                    'namespace': < _ | `reference` < < < | `internal` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                    'type': < _ | `reference` < < < | `internal` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                } >
                                'sibling': < _ _ | `group` {
                                    'namespace': < _ | `reference` < < < | `internal` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                    'type': < _ | `reference` < < < | `internal` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                } >
                            } * < < | `internal` 'Type' > < [] > > > >
                        } >
                        'Types': < | `dictionary` < | `component` < | `internal cyclic` 'Type' _ > > >
                        'Value': < | `state` < {
                            'component': < * "Reference to another reusable named type" _ | `group` {
                                'type': < _ | `state` < {
                                    'internal': < * "Reference a type within the same schema (no cycles)" _ | `reference` < < < | `internal` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    'child': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `internal` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `internal` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'internal cyclic': < * "Reference a type within the same schema (allows cycles)" _ | `reference` < < < | `internal` 'Types' > < [] > > < | `cyclic` ~ _ > > >
                                } * < < | `internal` 'Type' > < [] > > > >
                                'constraints': < * "Types exposed by named component constraints" | `component` < | `internal cyclic` 'Reference Constraints' _ > >
                            } >
                            'dictionary': < * "Indexed collection of named values (like a map or hash table)" _ | `component` < | `internal` 'Dictionary' _ > >
                            'group': < * "Ordered collection of properties, each with a specific name and type" _ | `component` < | `internal` 'Group' _ > >
                            'list': < * "Ordered sequence of values of the same type" _ | `group` {
                                'value': < _ | `component` < | `internal cyclic` 'Value' _ > >
                                'result': < _ | `component` < | `internal cyclic` 'Value Result' _ > >
                            } >
                            'nothing': < * "Empty value (unit type, no data)" _ | `nothing` ~ >
                            'simple': < * "A basic type with token syntax and an optional regular expression" * {
                                'basic types': < < | `internal` 'Basic Types' > < [] > >
                            } | `reference` < < < | `internal` 'Basic Types' > < [] > > < | `acyclic` ~ _ > > >
                            'optional': < * "Value that may or may not be present" _ | `group` {
                                'constraints': < _ | `component` < | `internal cyclic` 'Option Constraints' _ > >
                                'value': < _ | `component` < | `internal cyclic` 'Value' _ > >
                                'result': < * "The declared type of the result when this optional is present" | `component` < | `internal cyclic` 'Value Result' _ > >
                            } >
                            'reference': < * "Pointer to another value in the data (like a foreign key)" _ | `component` < | `internal cyclic` 'Reference' _ > >
                            'state': < * "Tagged union: value is one of several named options (like a sum type or enum)" _ | `group` {
                                'options': < * "The possible variants, each with its own name and associated data" | `dictionary` < | `group` {
                                    'description': < * "Documentation shown in IDE for this option" | `optional` < _ | `simple` 'multi line text' _ > >
                                    'constraints': < _ | `component` < | `internal cyclic` 'Option Constraints' _ > >
                                    'value': < _ | `component` < | `internal cyclic` 'Value' _ > >
                                } > >
                                'result': < _ | `component` < | `internal cyclic` 'Value Result' _ > >
                            } >
                        } _ > >
                        'Value Subselection': < | `group` {
                            'tail': < * "Navigate through nested structures: groups, states, dictionaries, lists, optionals" | `list` < | `state` < {
                                'dictionary': < * "Navigate into a dictionary's values" * {
                                    'definition': < < | `internal` 'Value' > < [
                                        | `state` 'dictionary'
                                    ] > >
                                } | `nothing` ~ >
                                'group': < * "Navigate to a specific property in a group" * {
                                    'definition': < < | `internal` 'Value' > < [
                                        | `state` 'group'
                                    ] > >
                                } | `reference` < < < | `internal` 'Group' > < [] > > < | `acyclic` ~ _ > > >
                                'list': < * "Navigate into a list's elements" * {
                                    'definition': < < | `internal` 'Value' > < [
                                        | `state` 'list'
                                    ] > >
                                } | `nothing` ~ >
                                'optional': < * "Navigate into an optional's value" * {
                                    'definition': < < | `internal` 'Value' > < [
                                        | `state` 'optional'
                                    ] > >
                                } | `nothing` ~ >
                                'state': < * "Navigate to a specific option in a state" * {
                                    'definition': < < | `internal` 'Value' > < [
                                        | `state` 'state'
                                    ] > >
                                } | `reference` < < < | `internal` 'Value' > < [
                                    | `state` 'state'
                                    | `group` 'options'
                                ] > > < | `acyclic` ~ _ > > >
                            } * < < | `internal` 'Value' > < [] > > > * < < | `internal` 'Value' > < [] > > > >
                        } >
                        'Value Reference': < | `group` {
                            'type': < _ | `component` < | `internal` 'Type Reference' _ > >
                            'path': < _ | `component` < | `internal` 'Value Subselection' _ > >
                        } >
                        'Value Result': < | `optional` < _ | `component` < | `internal` 'Value Reference' _ > _ > >
                    }
                )
                'declarations': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Presence': < | `state` < {
                            'optional': < * "This parameter may be omitted" _ | `nothing` ~ >
                            'required': < * "This parameter must be provided" _ | `nothing` ~ >
                        } _ > >
                        'Declaration': < | `group` {
                            'signature': < * "The resolver contract, defined locally or shared with another declaration" | `state` < {
                                'local': < _ _ | `component` < | `internal` 'Signature' _ > >
                                'same as': < _ _ | `reference` < < < | `internal` 'Declarations' > < [] > > < | `acyclic` ~ _ > > >
                            } * < < | `internal` 'Signature' > < [] > > > >
                        } >
                        'Signature': < | `group` {
                            'values': < _ | `dictionary` < | `group` {
                                'value': < * "The structural value selected by this parameter" | `component` < | `internal` 'Signature Value Reference' _ > >
                                'presence': < _ | `component` < | `internal` 'Presence' _ > >
                            } > >
                            'lookups': < _ | `dictionary` < | `group` {
                                'referent': < _ | `component` < | `internal` 'Signature Value Reference' * {
                                    'dictionary': (
                                        `type`: (
                                            `location`: | `sibling` (
                                                `namespace`: 'structure'
                                                `type`: 'Value'
                                            )
                                        )
                                        `path`: (
                                            `tail`: [
                                                | `state` 'dictionary'
                                            ]
                                        )
                                    )
                                } > >
                                'type': < _ | `state` < {
                                    'cyclic': < _ _ | `nothing` ~ >
                                    'acyclic': < _ _ | `nothing` ~ >
                                } _ > >
                                'presence': < _ | `component` < | `internal` 'Presence' _ > >
                            } > >
                        } >
                        'Declarations': < | `dictionary` < | `component` < | `internal cyclic` 'Declaration' _ > > >
                        'Signature Value Reference': < | `group` {
                            'type': < _ | `component` < | `internal` 'Signature Type Reference' _ > >
                            'subselection': < _ | `component` < | `internal` 'Signature Value Subselection' _ > >
                        } >
                        'Signature Value Subselection': < | `group` {
                            'tail': < * "Navigate through nested structures: groups, states, dictionaries, lists, optionals" | `list` < | `state` < {
                                'dictionary': < * "Navigate into a dictionary's values" * {
                                    'definition': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'dictionary'
                                    ] > >
                                } | `nothing` ~ >
                                'group': < * "Navigate to a specific property in a group" * {
                                    'definition': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'group'
                                    ] > >
                                } | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ _ > > >
                                'list': < * "Navigate into a list's elements" * {
                                    'definition': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'list'
                                    ] > >
                                } | `nothing` ~ >
                                'optional': < * "Navigate into an optional's value" * {
                                    'definition': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'optional'
                                    ] > >
                                } | `nothing` ~ >
                                'state': < * "Navigate to a specific option in a state" * {
                                    'definition': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'state'
                                    ] > >
                                } | `reference` < < < | `sibling` < 'structure' 'Value' > > < [
                                    | `state` 'state'
                                    | `group` 'options'
                                ] > > < | `acyclic` ~ _ > > >
                            } * < < | `sibling` < 'structure' 'Value' > > < [] > > > * < < | `sibling` < 'structure' 'Value' > > < [] > > > >
                        } >
                        'Signature Type Reference': < | `group` {
                            'location': < * "Where the referenced type is defined" | `state` < {
                                'internal': < * "Type is in the same schema" _ | `reference` < < < | `sibling` < 'structure' 'Types' > > < [] > > < | `acyclic` ~ _ > > >
                                'child': < _ _ | `group` {
                                    'namespace': < _ | `reference` < < < | `sibling` < 'structure' 'Namespaces' > > < [] > > < | `acyclic` ~ _ > > >
                                    'type': < _ | `reference` < < < | `sibling` < 'structure' 'Types' > > < [] > > < | `acyclic` ~ _ > > >
                                } >
                                'sibling': < _ _ | `group` {
                                    'namespace': < _ | `reference` < < < | `sibling` < 'structure' 'Namespaces' > > < [] > > < | `acyclic` ~ _ > > >
                                    'type': < _ | `reference` < < < | `sibling` < 'structure' 'Types' > > < [] > > < | `acyclic` ~ _ > > >
                                } >
                            } * < < | `sibling` < 'structure' 'Type' > > < [] > > > >
                        } >
                        'Namespaces': < | `dictionary` < | `component` < | `internal cyclic` 'Declaration Namespace' _ > > >
                        'Declaration Namespace': < | `group` {
                            'namespaces': < _ | `component` < | `internal` 'Namespaces' _ > >
                            'types': < _ | `component` < | `internal` 'Declarations' _ > >
                        } >
                    }
                )
                'resolver': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Absence Constraints': < | `optional` < _ | `dictionary` < | `component` < | `internal cyclic` 'Possible Value Selection' _ > > _ > >
                        'Benchmark': < | `group` {
                            'selection': < _ | `component` < | `internal` 'Guaranteed Value Selection' * {
                                'dictionary': (
                                    `type`: (
                                        `location`: | `sibling` (
                                            `namespace`: 'structure'
                                            `type`: 'Value'
                                        )
                                    )
                                    `path`: (
                                        `tail`: [
                                            | `state` 'dictionary'
                                        ]
                                    )
                                )
                            } > >
                            'coverage': < _ | `state` < {
                                'dense': < * "Every benchmark entry must be covered" _ | `nothing` ~ >
                                'sparse': < * "A subset of benchmark entries may be covered" _ | `nothing` ~ >
                            } _ > >
                        } >
                        'Constraint': < | `group` {
                            'selection': < _ | `component` < | `internal` 'Relative Value Selection' _ > >
                            'type': < _ | `state` < {
                                'state': < _ * {
                                    'state': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'state'
                                    ] > >
                                } | `group` {
                                    'option': < _ | `reference` < < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'state'
                                        | `group` 'options'
                                    ] > > < | `acyclic` ~ _ > > >
                                } >
                                'optional value': < _ * {
                                    'optional': < < | `sibling` < 'structure' 'Value' > > < [
                                        | `state` 'optional'
                                    ] > >
                                } | `group` {} >
                            } * < < | `sibling` < 'structure' 'Value' > > < [] > > > >
                        } >
                        'Guaranteed Value Selection': < | `group` {
                            'start': < _ | `state` < {
                                'optional fallback': < * "Use the possible selection when present, otherwise the fallback; both selections must target the same structural value" _ | `group` {
                                    'selection': < _ | `component` < | `internal cyclic` 'Possible Value Selection' _ > >
                                    'fallback': < _ | `component` < | `internal cyclic` 'Guaranteed Value Selection' _ > >
                                } >
                                'sibling': < _ _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ _ > > >
                                'parent sibling': < _ _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ _ > > >
                                'option constraint': < _ * {
                                    'oc': < < | `sibling` < 'structure' 'Option Constraints' > > < [] > >
                                } | `reference` < < < | `sibling` < 'structure' 'Option Constraints' > > < [
                                    | `optional` ~
                                ] > > < | `acyclic` ~ _ > > >
                                'list cursor': < _ * {
                                    'result': < < | `sibling` < 'structure' 'Value Result' > > < [
                                        | `optional` ~
                                    ] > >
                                } | `nothing` ~ >
                                'linked entry': < _ * {
                                    'entry': < < | `sibling` < 'structure' 'Value' > > < [] > >
                                } | `nothing` ~ >
                                'constraint': < _ _ | `state` < {
                                    'component': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'component': < < | `sibling` < 'structure' 'Value' > > < [
                                                | `state` 'component'
                                            ] > >
                                        } > > >
                                        'constraint': < _ | `reference` < < < | `sibling` < 'structure' 'Reference Constraints' > > < [
                                            | `optional` ~
                                        ] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'reference': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'reference': < < | `sibling` < 'structure' 'Value' > > < [
                                                | `state` 'reference'
                                            ] > >
                                        } > > >
                                        'constraint': < _ | `reference` < < < | `sibling` < 'structure' 'Reference Constraints' > > < [
                                            | `optional` ~
                                        ] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `sibling` < 'structure' 'Value' > > < [] > > > >
                                'parameter': < _ _ | `reference` < < < | `sibling` < 'declarations' 'Signature' > > < [
                                    | `group` 'values'
                                ] > > < | `acyclic` ~ _ > > >
                                'result': < _ _ | `state` < {
                                    'list': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'list': < < | `sibling` < 'structure' 'Value' > > < [
                                                | `state` 'list'
                                            ] > >
                                            'result': < < | `sibling` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                    'state': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'state': < < | `sibling` < 'structure' 'Value' > > < [
                                                | `state` 'state'
                                            ] > >
                                            'result': < < | `sibling` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                    'optional value': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'optional': < < | `sibling` < 'structure' 'Value' > > < [
                                                | `state` 'optional'
                                            ] > >
                                            'result': < < | `sibling` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                } * < < | `sibling` < 'structure' 'Value' > > < [] > > > >
                            } * < < | `sibling` < 'structure' 'Value' > > < [] > > > >
                            'tail': < _ | `component` < | `internal` 'Relative Value Selection' _ > >
                        } >
                        'Lookup Selection': < | `group` {
                            'type': < _ | `state` < {
                                'acyclic': < _ _ | `state` < {
                                    'siblings': < _ * {
                                        'cd': < < | `sibling` < 'structure' 'Dictionary' > > < [] > >
                                    } | `nothing` ~ >
                                    'resolved dictionary': < _ _ | `group` {
                                        'selection': < _ | `component` < | `internal` 'Guaranteed Value Selection' * {
                                            'dictionary': (
                                                `type`: (
                                                    `location`: | `sibling` (
                                                        `namespace`: 'structure'
                                                        `type`: 'Value'
                                                    )
                                                )
                                                `path`: (
                                                    `tail`: [
                                                        | `state` 'dictionary'
                                                    ]
                                                )
                                            )
                                        } > >
                                    } >
                                } * < < | `sibling` < 'structure' 'Dictionary' > > < [] > > > >
                                'cyclic': < _ _ | `state` < {
                                    'siblings': < _ * {
                                        'cd': < < | `sibling` < 'structure' 'Dictionary' > > < [] > >
                                    } | `nothing` ~ >
                                } * < < | `sibling` < 'structure' 'Dictionary' > > < [] > > > >
                                'parameter': < _ _ | `reference` < < < | `sibling` < 'declarations' 'Signature' > > < [
                                    | `group` 'lookups'
                                ] > > < | `acyclic` ~ _ > > >
                            } * < < | `sibling` < 'structure' 'Dictionary' > > < [] > > > >
                        } >
                        'Namespaces': < | `dictionary` < | `component` < | `internal cyclic` 'Resolver' _ > > >
                        'Option Constraints': < | `optional` < * {
                            'declarations': < < | `sibling` < 'structure' 'Option Constraints' > > < [
                                | `optional` ~
                            ] > >
                        } | `dictionary` < | `state` < {
                            'state': < _ _ | `group` {
                                'selection': < _ | `component` < | `internal cyclic` 'Guaranteed Value Selection' * {
                                    'state': (
                                        `type`: (
                                            `location`: | `sibling` (
                                                `namespace`: 'structure'
                                                `type`: 'Value'
                                            )
                                        )
                                        `path`: (
                                            `tail`: [
                                                | `state` 'state'
                                            ]
                                        )
                                    )
                                } > >
                                'option': < _ | `reference` < < < | `sibling` < 'structure' 'Value' > > < [
                                    | `state` 'state'
                                    | `group` 'options'
