/*
TODO:
- type visibility: propagate to processors and deployed schemas; constraints below require public types for root selection and cross-namespace component containment
- constraints that don't provide access to a value (but are needed for semantic correctness);
-- optional values should be able to have a constraint on 'not set' requiring that another value is also 'not set'
-- Identity constraints. It should be possible to have 2 paths that must point to the same value.
*/
(
    `schema`: (
        `structure`: (
            `namespaces`: {
                'structure': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Basic Types': < | `private` ~ | `dictionary` < | `group` {
                            'type': < * "How the value is delimited in a document" | `state` < {
                                'double quoted': < _ _ | `nothing` ~ >
                                'undelimited': < _ _ | `nothing` ~ >
                            } _ > >
                            'regular expression': < * "Optional regular expression matched against the entire value" | `optional` < _ | `component` < | `local` 'Regular Expression' _ > _ > >
                            'hyperlink': < * "Optional hyperlink metadata; the target is prefix + authored value + suffix, without changing the authored value" | `optional` < _ | `group` {
                                'prefix': < _ | `simple` 'text' >
                                'suffix': < _ | `simple` 'text' >
                            } _ > >
                        } > >
                        'Dictionary': < | `private` ~ | `group` {
                            'value': < * "The type of each entry in this dictionary" | `component` < | `local cyclic` 'Value' _ > >
                        } >
                        'Group': < | `private` ~ | `dictionary` < | `group` {
                            'description': < * "Documentation shown in IDE for this property" | `optional` < _ | `simple` 'multi line text' _ > >
                            'value': < * "The type of this property" | `component` < | `local cyclic` 'Value' _ > >
                        } > >
                        'Namespaces': < | `private` ~ | `dictionary` < | `component` < | `local cyclic` 'Structure' _ > > >
                        'Option Constraints': < | `private` ~ | `optional` < _ | `dictionary` < | `component` < | `local` 'Value Reference' _ > > _ > >
                        'Reference': < | `private single use` ~ | `group` {
                            'referent': < * "What this reference points to" | `component` < | `local cyclic` 'Value Reference' * {
                                'dictionary': (
                                    `type`: (
                                        `location`: | `local` 'Value'
                                    )
                                    `path`: (
                                        `tail`: [
                                            | `state` 'dictionary'
                                        ]
                                    )
                                )
                            } > >
                            'type': < _ | `group` {
                                'dependency': < * "How this reference affects dependency order" | `state` < {
                                    'acyclic': < * "No circular dependencies (default for cross-type references)" _ | `nothing` ~ >
                                    'cyclic': < * "Allows circular instance references (only within same dictionary)" _ | `nothing` ~ >
                                } _ > >
                                'constraints': < _ | `component` < | `local cyclic` 'Reference Constraints' _ > >
                            } >
                        } >
                        'Reference Constraints': < | `private` ~ | `optional` < _ | `dictionary` < | `component` < | `local` 'Value Reference' _ > > _ > >
                        'Regular Expression': < | `private` ~ | `state` < {
                            'any character': < * "Match exactly one character, including line breaks" _ | `nothing` ~ >
                            'literal': < * "Match this exact text; an empty literal matches no characters" _ | `simple` 'text' >
                            'character set': < * "Match exactly one character from this text; an empty set never matches. Use 0123456789 for JSON digits" _ | `simple` 'text' >
                            'sequence': < * "Match every expression in order; an empty sequence matches no characters" _ | `list` < | `component` < | `local cyclic` 'Regular Expression' _ > _ > >
                            'choice': < * "Match any one expression; an empty choice never matches" _ | `list` < | `component` < | `local cyclic` 'Regular Expression' _ > _ > >
                            'repetition': < * "Repeat an expression using one of the three basic quantifiers" _ | `group` {
                                'expression': < _ | `component` < | `local cyclic` 'Regular Expression' _ > >
                                'quantity': < _ | `state` < {
                                    'optional': < * "Zero or one occurrence" _ | `nothing` ~ >
                                    'zero or more': < _ _ | `nothing` ~ >
                                    'one or more': < _ _ | `nothing` ~ >
                                } _ > >
                            } >
                        } _ > >
                        'Structure': < | `public` ~ | `group` {
                            'namespaces': < _ | `component` < | `local` 'Namespaces' _ > >
                            'basic types': < _ | `component` < | `local` 'Basic Types' _ > >
                            'types': < _ | `component` < | `local cyclic` 'Types' _ > >
                        } >
                        'Type': < | `private` ~ | `group` {
                            'visibility': < * "Private types can only be contained as components within their namespace; public types can also be contained from other namespaces or selected as the document root. References may target any visibility. Private single use marks an intentional single-use private type; usage counts are not enforced" | `state` < {
                                'private': < _ _ | `nothing` ~ >
                                'private single use': < * "Intentional single-use private type retained as a structural or resolver boundary" _ | `nothing` ~ >
                                'public': < _ _ | `nothing` ~ >
                            } _ > >
                            'root value': < _ | `component` < | `local cyclic` 'Value' _ > >
                        } >
                        'Types': < | `private` ~ | `dictionary` < | `component` < | `local cyclic` 'Type' _ > > >
                        'Value': < | `private` ~ | `state` < {
                            'component': < * "Reference to another reusable named type" _ | `group` {
                                'type': < _ | `state` < {
                                    'local': < * "Reference a type within the current namespace (no cycles)" _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    'child namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ * {
                                            'public': < < | `local` 'Type' > < [ | `group` 'visibility' | `state` 'public' ] > >
                                        } > > >
                                    } >
                                    'local cyclic': < * "Reference a type within the current namespace (allows cycles)" _ | `reference` < < < | `local` 'Types' > < [] > > < | `cyclic` ~ _ > > >
                                    'sibling namespace': < * "Reference a type in an acyclic sibling namespace" _ | `group` {
                                        'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ * {
                                            'public': < < | `local` 'Type' > < [ | `group` 'visibility' | `state` 'public' ] > >
                                        } > > >
                                    } >
                                } * < < | `local` 'Type' > < [] > > > >
                                'constraints': < * "Types exposed by named component constraints" | `component` < | `local cyclic` 'Reference Constraints' _ > >
                            } >
                            'dictionary': < * "Indexed collection of named values (like a map or hash table)" _ | `component` < | `local` 'Dictionary' _ > >
                            'group': < * "Ordered collection of properties, each with a specific name and type" _ | `component` < | `local` 'Group' _ > >
                            'list': < * "Ordered sequence of values of the same type" _ | `group` {
                                'value': < _ | `component` < | `local cyclic` 'Value' _ > >
                                'result': < _ | `component` < | `local cyclic` 'Value Result' _ > >
                            } >
                            'nothing': < * "Empty value (unit type, no data)" _ | `nothing` ~ >
                            'simple': < * "A basic type with token syntax and an optional regular expression" * {
                                'basic types': < < | `local` 'Basic Types' > < [] > >
                            } | `reference` < < < | `local` 'Basic Types' > < [] > > < | `acyclic` ~ _ > > >
                            'optional': < * "Value that may or may not be present" _ | `group` {
                                'constraints': < _ | `component` < | `local cyclic` 'Option Constraints' _ > >
                                'value': < _ | `component` < | `local cyclic` 'Value' _ > >
                                'result': < * "The declared type of the result when this optional is present" | `component` < | `local cyclic` 'Value Result' _ > >
                            } >
                            'reference': < * "Pointer to another value in the data (like a foreign key)" _ | `component` < | `local cyclic` 'Reference' _ > >
                            'state': < * "Tagged union: value is one of several named options (like a sum type or enum)" _ | `group` {
                                'options': < * "The possible variants, each with its own name and associated data" | `dictionary` < | `group` {
                                    'description': < * "Documentation shown in IDE for this option" | `optional` < _ | `simple` 'multi line text' _ > >
                                    'constraints': < _ | `component` < | `local cyclic` 'Option Constraints' _ > >
                                    'value': < _ | `component` < | `local cyclic` 'Value' _ > >
                                } > >
                                'result': < _ | `component` < | `local cyclic` 'Value Result' _ > >
                            } >
                        } _ > >
                        'Value Reference': < | `private` ~ | `group` {
                            'type': < _ | `group` {
                                'location': < * "Where the referenced type is defined" | `state` < {
                                    'local': < * "Type is in the current namespace" _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    'child namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'sibling namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `local` 'Type' > < [] > > > >
                            } >
                            'path': < _ | `group` {
                                'tail': < * "Navigate through nested structures: groups, states, dictionaries, lists, optionals" | `list` < | `state` < {
                                    'dictionary': < * "Navigate into a dictionary's values" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'dictionary'
                                        ] > >
                                    } | `nothing` ~ >
                                    'group': < * "Navigate to a specific property in a group" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'group'
                                        ] > >
                                    } | `reference` < < < | `local` 'Group' > < [] > > < | `acyclic` ~ _ > > >
                                    'list': < * "Navigate into a list's elements" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'list'
                                        ] > >
                                    } | `nothing` ~ >
                                    'optional': < * "Navigate into an optional's value" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'optional'
                                        ] > >
                                    } | `nothing` ~ >
                                    'state': < * "Navigate to a specific option in a state" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'state'
                                        ] > >
                                    } | `reference` < < < | `local` 'Value' > < [
                                        | `state` 'state'
                                        | `group` 'options'
                                    ] > > < | `acyclic` ~ _ > > >
                                } * < < | `local` 'Value' > < [] > > > * < < | `local` 'Value' > < [] > > > >
                            } >
                        } >
                        'Value Result': < | `private` ~ | `optional` < _ | `component` < | `local` 'Value Reference' _ > _ > >
                    }
                )
                'declarations': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Presence': < | `private` ~ | `state` < {
                            'optional': < * "This parameter may be omitted" _ | `nothing` ~ >
                            'required': < * "This parameter must be provided" _ | `nothing` ~ >
                        } _ > >
                        'Declaration': < | `private` ~ | `group` {
                            'signature': < * "The resolver contract, defined locally or shared with another declaration" | `state` < {
