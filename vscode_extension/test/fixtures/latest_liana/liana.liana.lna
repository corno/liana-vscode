                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `local` 'Type' > < [] > > > >
                            } >
                            'path': < _ | `group` {
                                'tail': < * "Navigate through nested structures: groups, states, dictionaries, benchmarks, lists, optionals" | `list` < | `state` < {
