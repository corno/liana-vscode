                        'Declarations': < | `private` ~ | `dictionary` < * < < | `sibling namespace` < 'structure' 'Types' > > < [  ] > > | `component` < | `simple` | `local` 'Declaration' _ > > >
                        'Signature Value Reference': < | `private` ~ | `group` {
