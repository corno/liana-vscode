                                        ] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                                'parameter': < _ _ | `reference` < < < | `sibling namespace` < 'declarations' 'Signature' > > < [
                                    | `group` 'values'
                                ] > > < | `acyclic` ~ _ > > >
                                'result': < _ _ | `state` < {
                                    'list': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'list': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'list'
                                            ] > >
                                            'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                    'state': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'state': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'state'
                                            ] > >
                                            'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                    'optional value': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'optional': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'optional'
                                            ] > >
                                            'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                            } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                            'tail': < _ | `component` < | `local` 'Relative Value Selection' _ > >
                        } >
                        'Lookup Selection': < | `private` ~ | `group` {
                            'type': < _ | `state` < {
                                'acyclic': < _ _ | `state` < {
                                    'siblings': < _ * {
                                        'cd': < < | `sibling namespace` < 'structure' 'Dictionary' > > < [] > >
