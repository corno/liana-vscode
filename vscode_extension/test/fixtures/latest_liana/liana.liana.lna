                                            ] > >
                                        } > > >
                                        'constraint': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Reference Constraints' > > < [
                                            | `optional` ~
                                        ] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'reference': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'reference': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'reference'
                                            ] > >
                                        } > > >
                                        'constraint': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Reference Constraints' > > < [
