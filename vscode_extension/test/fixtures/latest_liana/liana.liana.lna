/*
TODO:
- type visibility: propagate to processors and deployed schemas; constraints below require public types for root selection and cross-namespace component containment
- constraints that don't provide access to a value (but are needed for semantic correctness);
-- optional values should be able to have a constraint on 'not set' requiring that another value is also 'not set'
-- Identity constraints. It should be possible to have 2 paths that must point to the same value.
*/
(
    `schema`: (
        `structure`: (
            `namespaces`: {
                'structure': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Basic Types': < | `private` ~ | `dictionary` < _ | `group` {
                            'type': < * "How the value is delimited in a document" | `state` < {
                                'double quoted': < _ _ | `nothing` ~ >
                                'undelimited': < _ _ | `nothing` ~ >
                            } _ > >
                            'regular expression': < * "Optional regular expression matched against the entire value" | `optional` < _ | `component` < | `cyclic` 'Regular Expression' _ > _ > >
                            'hyperlink': < * "Optional hyperlink metadata; the target is prefix + authored value + suffix, without changing the authored value" | `optional` < _ | `group` {
                                'prefix': < _ | `simple` 'text' >
                                'suffix': < _ | `simple` 'text' >
                            } _ > >
                        } > >
                        'Dictionary': < | `private` ~ | `group` {
                            'benchmark': < * "Optional benchmark target and coverage contract; the resolver selects its dictionary instance" | `optional` < _ | `group` {
                                'selection': < _ | `component` < | `cyclic` 'Value Reference' * {
                                    'dictionary': < < | `local` 'Value' > < [
                                        | `state` 'dictionary'
                                    ] > >
                                } > >
                                'coverage': < _ | `state` < {
                                    'dense': < * "Every benchmark entry must be covered" _ | `nothing` ~ >
                                    'sparse': < * "A subset of benchmark entries may be covered" _ | `nothing` ~ >
                                } _ > >
                            } _ > >
                            'value': < * "The type of each entry in this dictionary" | `component` < | `cyclic` 'Value' _ > >
                        } >
                        'Group': < | `private` ~ | `dictionary` < _ | `group` {
                            'description': < * "Documentation shown in IDE for this property" | `optional` < _ | `simple` 'multi line text' _ > >
                            'value': < * "The type of this property" | `component` < | `cyclic` 'Value' _ > >
                        } > >
                        'Namespaces': < | `private` ~ | `dictionary` < _ | `component` < | `cyclic` 'Structure' _ > > >
                        'Option Constraints': < | `private` ~ | `optional` < _ | `dictionary` < _ | `component` < | `simple` | `local` 'Value Reference' _ > > _ > >
                        'Reference': < | `private single use` ~ | `group` {
                            'referent': < * "What this reference points to" | `component` < | `cyclic` 'Value Reference' * {
                                'dictionary': (
                                    `type`: (
                                        `location`: | `local` 'Value'
                                    )
                                    `path`: (
                                        `tail`: [
                                            | `state` 'dictionary'
                                        ]
                                    )
                                )
                            } > >
                            'type': < _ | `group` {
                                'dependency': < * "How this reference affects dependency order" | `state` < {
                                    'acyclic': < * "No circular dependencies (default for cross-type references)" _ | `nothing` ~ >
                                    'cyclic': < * "Allows circular instance references (only within same dictionary)" _ | `nothing` ~ >
                                } _ > >
                                'constraints': < _ | `component` < | `cyclic` 'Reference Constraints' _ > >
                            } >
                        } >
                        'Reference Constraints': < | `private` ~ | `optional` < _ | `dictionary` < _ | `component` < | `simple` | `local` 'Value Reference' _ > > _ > >
                        'Regular Expression': < | `private` ~ | `state` < {
                            'any character': < * "Match exactly one character, including line breaks" _ | `nothing` ~ >
                            'literal': < * "Match this exact text; an empty literal matches no characters" _ | `simple` 'text' >
                            'character set': < * "Match exactly one character from this text; an empty set never matches. Use 0123456789 for JSON digits" _ | `simple` 'text' >
                            'sequence': < * "Match every expression in order; an empty sequence matches no characters" _ | `list` < | `component` < | `cyclic` 'Regular Expression' _ > _ > >
                            'choice': < * "Match any one expression; an empty choice never matches" _ | `list` < | `component` < | `cyclic` 'Regular Expression' _ > _ > >
                            'repetition': < * "Repeat an expression using one of the three basic quantifiers" _ | `group` {
                                'expression': < _ | `component` < | `cyclic` 'Regular Expression' _ > >
                                'quantity': < _ | `state` < {
                                    'optional': < * "Zero or one occurrence" _ | `nothing` ~ >
                                    'zero or more': < _ _ | `nothing` ~ >
                                    'one or more': < _ _ | `nothing` ~ >
                                } _ > >
                            } >
                        } _ > >
                        'Structure': < | `public` ~ | `group` {
                            'namespaces': < _ | `component` < | `simple` | `local` 'Namespaces' _ > >
                            'basic types': < _ | `component` < | `simple` | `local` 'Basic Types' _ > >
                            'types': < _ | `component` < | `cyclic` 'Types' _ > >
                        } >
                        'Type': < | `private` ~ | `group` {
                            'visibility': < * "Private types can only be contained as components within their namespace; public types can also be contained from other namespaces or selected as the document root. References may target any visibility. Private single use marks an intentional single-use private type; usage counts are not enforced" | `state` < {
                                'private': < _ _ | `nothing` ~ >
                                'private single use': < * "Intentional single-use private type retained as a structural or resolver boundary" _ | `nothing` ~ >
                                'public': < _ _ | `nothing` ~ >
                            } _ > >
                            'root value': < _ | `component` < | `cyclic` 'Value' _ > >
                        } >
                        'Types': < | `private` ~ | `dictionary` < _ | `component` < | `cyclic` 'Type' _ > > >
                        'Value': < | `private` ~ | `state` < {
                            'component': < * "Reference to another reusable named type" _ | `group` {
                                'type': < _ | `state` < {
                                    'simple': < * "Expose the component target for navigation; local targets must be acyclic" _ | `state` < {
                                        'local': < * "Reference a type within the current namespace (no cycles)" _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                        'child namespace': < _ _ | `group` {
                                            'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                            'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ * {
                                                'public': < < | `local` 'Type' > < [
                                                    | `group` 'visibility'
                                                    | `state` 'public'
                                                ] > >
                                            } > > >
                                        } >
                                        'sibling namespace': < * "Reference a type in an acyclic sibling namespace" _ | `group` {
                                            'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                            'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ * {
                                                'public': < < | `local` 'Type' > < [
                                                    | `group` 'visibility'
                                                    | `state` 'public'
                                                ] > >
                                            } > > >
                                        } >
                                    } * < < | `local` 'Type' > < [] > > > >
                                    'cyclic': < * "Reference a type within the current namespace (allows cycles); the target is not exposed for navigation" _ | `reference` < < < | `local` 'Types' > < [] > > < | `cyclic` ~ _ > > >
                                } _ > >
                                'constraints': < * "Types exposed by named component constraints" | `component` < | `cyclic` 'Reference Constraints' _ > >
                            } >
                            'dictionary': < * "Indexed collection of named values (like a map or hash table)" _ | `component` < | `cyclic` 'Dictionary' _ > >
                            'group': < * "Ordered collection of properties, each with a specific name and type" _ | `component` < | `simple` | `local` 'Group' _ > >
                            'list': < * "Ordered sequence of values of the same type" _ | `group` {
                                'value': < _ | `component` < | `cyclic` 'Value' _ > >
                                'result': < _ | `component` < | `cyclic` 'Value Result' _ > >
                            } >
                            'nothing': < * "Empty value (unit type, no data)" _ | `nothing` ~ >
                            'simple': < * "A basic type with token syntax and an optional regular expression" * {
                                'basic types': < < | `local` 'Basic Types' > < [] > >
                            } | `reference` < < < | `local` 'Basic Types' > < [] > > < | `acyclic` ~ _ > > >
                            'optional': < * "Value that may or may not be present" _ | `group` {
                                'constraints': < _ | `component` < | `cyclic` 'Option Constraints' _ > >
                                'value': < _ | `component` < | `cyclic` 'Value' _ > >
                                'result': < * "The declared type of the result when this optional is present" | `component` < | `cyclic` 'Value Result' _ > >
                            } >
                            'reference': < * "Pointer to another value in the data (like a foreign key)" _ | `component` < | `cyclic` 'Reference' _ > >
                            'state': < * "Tagged union: value is one of several named options (like a sum type or enum)" _ | `group` {
                                'options': < * "The possible variants, each with its own name and associated data" | `dictionary` < _ | `group` {
                                    'description': < * "Documentation shown in IDE for this option" | `optional` < _ | `simple` 'multi line text' _ > >
                                    'constraints': < _ | `component` < | `cyclic` 'Option Constraints' _ > >
                                    'value': < _ | `component` < | `cyclic` 'Value' _ > >
                                } > >
                                'result': < _ | `component` < | `cyclic` 'Value Result' _ > >
                            } >
                        } _ > >
                        'Value Reference': < | `private` ~ | `group` {
                            'type': < _ | `group` {
                                'location': < * "Where the referenced type is defined" | `state` < {
                                    'local': < * "Type is in the current namespace" _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    'child namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'sibling namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `local` 'Namespaces' > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `local` 'Types' > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `local` 'Type' > < [] > > > >
                            } >
                            'path': < _ | `group` {
                                'tail': < * "Navigate through nested structures: groups, states, dictionaries, benchmarks, lists, optionals" | `list` < | `state` < {
                                    'benchmark': < * "Follow a dictionary's declared structural benchmark to the benchmark dictionary, not to an entry payload" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'dictionary'
                                        ] > >
                                    } | `nothing` ~ >
                                    'dictionary': < * "Navigate into a dictionary's values" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'dictionary'
                                        ] > >
                                    } | `nothing` ~ >
                                    'group': < * "Navigate to a specific property in a group" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'group'
                                        ] > >
                                    } | `reference` < < < | `local` 'Group' > < [] > > < | `acyclic` ~ _ > > >
                                    'list': < * "Navigate into a list's elements" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'list'
                                        ] > >
                                    } | `nothing` ~ >
                                    'optional': < * "Navigate into an optional's value" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'optional'
                                        ] > >
                                    } | `nothing` ~ >
                                    'state': < * "Navigate to a specific option in a state" * {
                                        'definition': < < | `local` 'Value' > < [
                                            | `state` 'state'
                                        ] > >
                                    } | `reference` < < < | `local` 'Value' > < [
                                        | `state` 'state'
                                        | `group` 'options'
                                    ] > > < | `acyclic` ~ _ > > >
                                } * < < | `local` 'Value' > < [] > > > * < < | `local` 'Value' > < [] > > > >
                            } >
                        } >
                        'Value Result': < | `private` ~ | `optional` < _ | `component` < | `simple` | `local` 'Value Reference' _ > _ > >
                    }
                )
                'declarations': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Presence': < | `private` ~ | `state` < {
                            'optional': < * "This parameter may be omitted" _ | `nothing` ~ >
                            'required': < * "This parameter must be provided" _ | `nothing` ~ >
                        } _ > >
                        'Declaration': < | `private` ~ | `group` {
                            'signature': < * "The resolver contract, defined locally or shared with another declaration" | `state` < {
                                'local': < _ _ | `component` < | `simple` | `local` 'Signature' _ > >
                                'same as': < _ _ | `reference` < < < | `local` 'Declarations' > < [] > > < | `acyclic` ~ _ > > >
                            } * < < | `local` 'Signature' > < [] > > > >
                        } >
                        'Signature': < | `private` ~ | `group` {
                            'values': < _ | `dictionary` < _ | `group` {
                                'value': < * "The structural value selected by this parameter" | `component` < | `simple` | `local` 'Signature Value Reference' _ > >
                                'presence': < _ | `component` < | `cyclic` 'Presence' _ > >
                            } > >
                            'lookups': < _ | `dictionary` < _ | `group` {
                                'referent': < _ | `component` < | `cyclic` 'Signature Value Reference' * {
                                    'dictionary': (
                                        `type`: (
                                            `location`: | `sibling namespace` (
                                                `namespace`: 'structure'
                                                `type`: 'Value'
                                            )
                                        )
                                        `path`: (
                                            `tail`: [
                                                | `state` 'dictionary'
                                            ]
                                        )
                                    )
                                } > >
                                'type': < _ | `state` < {
                                    'cyclic': < _ _ | `nothing` ~ >
                                    'acyclic': < _ _ | `nothing` ~ >
                                } _ > >
                                'presence': < _ | `component` < | `cyclic` 'Presence' _ > >
                            } > >
                        } >
                        'Declarations': < | `private` ~ | `dictionary` < * < < < | `sibling namespace` < 'structure' 'Types' > > < [  ] > > | `dense` ~ > | `component` < | `cyclic` 'Declaration' _ > > >
                        'Signature Value Reference': < | `private` ~ | `group` {
                            'type': < _ | `group` {
                                'location': < * "Where the referenced type is defined" | `state` < {
                                    'local': < * "Type is in the current namespace" _ | `reference` < < < | `sibling namespace` < 'structure' 'Types' > > < [] > > < | `acyclic` ~ _ > > >
                                    'child namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Namespaces' > > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Types' > > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'sibling namespace': < _ _ | `group` {
                                        'namespace': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Namespaces' > > < [] > > < | `acyclic` ~ _ > > >
                                        'type': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Types' > > < [] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `sibling namespace` < 'structure' 'Type' > > < [] > > > >
                            } >
                            'subselection': < _ | `group` {
                                'tail': < * "Navigate through nested structures: groups, states, dictionaries, lists, optionals" | `list` < | `state` < {
                                    'dictionary': < * "Navigate into a dictionary's values" * {
                                        'definition': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                            | `state` 'dictionary'
                                        ] > >
                                    } | `nothing` ~ >
                                    'group': < * "Navigate to a specific property in a group" * {
                                        'definition': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                            | `state` 'group'
                                        ] > >
                                    } | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ _ > > >
                                    'list': < * "Navigate into a list's elements" * {
                                        'definition': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                            | `state` 'list'
                                        ] > >
                                    } | `nothing` ~ >
                                    'optional': < * "Navigate into an optional's value" * {
                                        'definition': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                            | `state` 'optional'
                                        ] > >
                                    } | `nothing` ~ >
                                    'state': < * "Navigate to a specific option in a state" * {
                                        'definition': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                            | `state` 'state'
                                        ] > >
                                    } | `reference` < < < | `sibling namespace` < 'structure' 'Value' > > < [
                                        | `state` 'state'
                                        | `group` 'options'
                                    ] > > < | `acyclic` ~ _ > > >
                                } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                            } >
                        } >
                        'Namespaces': < | `private` ~ | `dictionary` < * < < < | `sibling namespace` < 'structure' 'Namespaces' > > < [  ] > > | `dense` ~ > | `component` < | `cyclic` 'Declaration Namespace' _ > > >
                        'Declaration Namespace': < | `public` ~ | `group` {
                            'namespaces': < _ | `component` < | `simple` | `local` 'Namespaces' _ > >
                            'types': < _ | `component` < | `simple` | `local` 'Declarations' _ > >
                        } >
                    }
                )
                'resolver': (
                    `namespaces`: {}
                    `basic types`: {
                        'multi line text': < | `double quoted` ~ _ _ >
                        'text': < | `double quoted` ~ _ _ >
                    }
                    `types`: {
                        'Guaranteed Value Selection': < | `private` ~ | `group` {
                            'start': < _ | `state` < {
                                'optional fallback': < * "Use the possible selection when present, otherwise the fallback; both selections must target the same structural value" _ | `group` {
                                    'selection': < _ | `component` < | `cyclic` 'Possible Value Selection' _ > >
                                    'fallback': < _ | `component` < | `cyclic` 'Guaranteed Value Selection' _ > >
                                } >
                                'sibling property': < * "Select another property of the containing group" _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ _ > > >
                                'parent sibling': < _ _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ _ > > >
                                'option constraint': < _ * {
                                    'oc': < < | `sibling namespace` < 'structure' 'Option Constraints' > > < [] > >
                                } | `reference` < < < | `sibling namespace` < 'structure' 'Option Constraints' > > < [
                                    | `optional` ~
                                ] > > < | `acyclic` ~ _ > > >
                                'sibling option constraint': < * "Use another constraint from this option-constraint block; dependencies must be acyclic" _ | `reference` < < < | `local` 'Option Constraints' > < [
                                    | `optional` ~
                                ] > > < | `acyclic` ~ _ > > >
                                'list cursor': < _ * {
                                    'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                        | `optional` ~
                                    ] > >
                                } | `nothing` ~ >
                                'linked entry': < _ * {
                                    'entry': < < | `sibling namespace` < 'structure' 'Value' > > < [] > >
                                } | `nothing` ~ >
                                'constraint': < _ _ | `state` < {
                                    'component': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'component': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'component'
                                            ] > >
                                        } > > >
                                        'constraint': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Reference Constraints' > > < [
                                            | `optional` ~
                                        ] > > < | `acyclic` ~ _ > > >
                                    } >
                                    'reference': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'reference': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'reference'
                                            ] > >
                                        } > > >
                                        'constraint': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Reference Constraints' > > < [
                                            | `optional` ~
                                        ] > > < | `acyclic` ~ _ > > >
                                    } >
                                } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                                'parameter': < _ _ | `reference` < < < | `sibling namespace` < 'declarations' 'Signature' > > < [
                                    | `group` 'values'
                                ] > > < | `acyclic` ~ _ > > >
                                'result': < _ _ | `state` < {
                                    'list': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'list': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'list'
                                            ] > >
                                            'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                    'state': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'state': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'state'
                                            ] > >
                                            'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                    'optional value': < _ _ | `group` {
                                        'property': < _ | `reference` < < < | `sibling namespace` < 'structure' 'Group' > > < [] > > < | `acyclic` ~ * {
                                            'optional': < < | `sibling namespace` < 'structure' 'Value' > > < [
                                                | `state` 'optional'
                                            ] > >
                                            'result': < < | `sibling namespace` < 'structure' 'Value Result' > > < [
                                                | `optional` ~
                                            ] > >
                                        } > > >
                                    } >
                                } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                            } * < < | `sibling namespace` < 'structure' 'Value' > > < [] > > > >
                            'tail': < _ | `component` < | `simple` | `local` 'Relative Value Selection' _ > >
                        } >
                        'Lookup Selection': < | `private` ~ | `group` {
                            'type': < _ | `state` < {
                                'acyclic': < _ _ | `state` < {
                                    'siblings': < _ * {
                                        'cd': < < | `sibling namespace` < 'structure' 'Dictionary' > > < [] > >
                                    } | `nothing` ~ >
                                    'resolved dictionary': < _ _ | `group` {
                                        'selection': < _ | `component` < | `cyclic` 'Guaranteed Value Selection' * {
                                            'dictionary': (
                                                `type`: (
                                                    `location`: | `sibling namespace` (
                                                        `namespace`: 'structure'
                                                        `type`: 'Value'
                                                    )
                                                )
                                                `path`: (
                                                    `tail`: [
                                                        | `state` 'dictionary'
                                                    ]
                                                )
                                            )
                                        } > >
                                    } >
                                } * < < | `sibling namespace` < 'structure' 'Dictionary' > > < [] > > > >
                                'cyclic': < _ _ | `state` < {
                                    'siblings': < _ * {
                                        'cd': < < | `sibling namespace` < 'structure' 'Dictionary' > > < [] > >
                                    } | `nothing` ~ >
                                } * < < | `sibling namespace` < 'structure' 'Dictionary' > > < [] > > > >
                                'parameter': < _ _ | `reference` < < < | `sibling namespace` < 'declarations' 'Signature' > > < [
                                    | `group` 'lookups'
                                ] > > < | `acyclic` ~ _ > > >
